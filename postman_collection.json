            { "key": "idBackPhoto", "type": "file", "src": "/path/to/idBackPhoto.jpg" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "register"]
