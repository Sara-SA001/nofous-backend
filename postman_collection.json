    {
      "name": "Request Family Link",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" },
          { "key": "Content-Type", "value": "multipart/form-data" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "targetId", "value": "{{targetId}}", "type": "text" },
            { "key": "type", "value": "FATHER_LINK", "type": "text" },
            { "key": "notes", "value": "طلب ارتباط الأب", "type": "text" },
            { "key": "document1", "type": "file", "src": "/path/to/document1.jpg" },
            { "key": "document2", "type": "file", "src": "/path/to/document2.jpg" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/link/request",
          "host": ["{{base_url}}"],
          "path": ["api", "link", "request"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Request family link returns success', function () {",
              "  pm.expect(json.success).to.eql(true);",
              "});",
              "if (json.request && json.request.id) { pm.collectionVariables.set('linkRequestId', json.request.id); }"
            ]
          }
        }
      ]
    },
